# Alpaca paper-trading API keys. Create a free account at
# https://alpaca.markets, generate paper keys from the dashboard
# (Paper Trading -> API Keys). These are sandbox-only credentials --
# no real money, no payment method required.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Shared secret the scheduled GitHub Actions workflow sends on every
# tick so /api/bot/tick can't be triggered by anyone else. Generate
# with: openssl rand -hex 32
BOT_SECRET=

# App login (single shared password, no user accounts/DB). Generate
# AUTH_SECRET the same way as BOT_SECRET -- it signs session cookies.
AUTH_PASSWORD=
AUTH_SECRET=
